# Copy this file to `.env.local` and fill in real PUBLIC contact destinations.
# These values are visible in the browser — never put secrets here.
# Restart `npm run dev` after changing them.

NEXT_PUBLIC_CONTACT_LINE_URL=
# Digits only, international format without "+", e.g. 66812345678
NEXT_PUBLIC_CONTACT_WHATSAPP_NUMBER=
# e.g. +6621234567
NEXT_PUBLIC_CONTACT_PHONE_NUMBER=
